# Copy to .env and fill in
NOSANA_API_KEY=nos_...
NOSANA_MODEL=            # optional; empty = auto-pick a live model from /v1/models
DAYTONA_API_KEY=dtn_...
TAVILY_API_KEY=tvly-...
REWRITE_ENGINE=llm       # or "codeaf" to use AgentField's CodeAF harness
# Optional fallback LLM (any OpenAI-compatible endpoint)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
